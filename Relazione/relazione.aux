\newlabel{subsec:risultati_distorsione}{{11.3}{39}{Risultati sperimentali: ampiezze armoniche (\texorpdfstring {$p_1, p_2$}{p1, p2}) e distorsione di secondo modo (\texorpdfstring {$p_2 / p_1$}{p2/p1})}{subsection.11.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces Ampiezze delle componenti armoniche all'uscita del circuito di condizionamento in funzione dell'ampiezza di eccitazione $V_{\text  {ac}}$ ($V_{\text  {DC}} = \SI {5.0}{\volt }$): componente fondamentale del primo modo $p_1$ a $f_1 \approx \SI {417.8}{\kilo \hertz }$ (cerchi blu e fit lineare $p_1 = k_1 V_{\text  {ac}}$) e componente di seconda armonica / secondo modo $p_2$ a $f_2 \approx \SI {835.6}{\kilo \hertz }$ (quadrati rossi e fit quadratico $p_2 = k_2 V_{\text  {ac}}^2$).}}{39}{figure.23}\protected@file@percent }
\newlabel{fig:distorsione_armoniche_vac}{{23}{39}{Ampiezze delle componenti armoniche all'uscita del circuito di condizionamento in funzione dell'ampiezza di eccitazione $V_{\text {ac}}$ ($V_{\text {DC}} = \SI {5.0}{\volt }$): componente fondamentale del primo modo $p_1$ a $f_1 \approx \SI {417.8}{\kilo \hertz }$ (cerchi blu e fit lineare $p_1 = k_1 V_{\text {ac}}$) e componente di seconda armonica / secondo modo $p_2$ a $f_2 \approx \SI {835.6}{\kilo \hertz }$ (quadrati rossi e fit quadratico $p_2 = k_2 V_{\text {ac}}^2$)}{figure.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {24}{\ignorespaces Rapporto di distorsione armonica di secondo modo $\text  {HD}_2 = p_2 / p_1$ (espresso in percentuale) in funzione dell'ampiezza di eccitazione $V_{\text  {ac}}$. I cerchi verdi rappresentano i dati sperimentali; la retta continua verde mostra la legge teorica lineare $\text  {HD}_2 = (k_2/k_1)\,V_{\text  {ac}}$ con pendenza $k_{\text  {hd2}} = \SI {0.01911}{\%/\milli \volt _{pp}}$.}}{40}{figure.24}\protected@file@percent }
\newlabel{fig:distorsione_hd2_rapporto}{{24}{40}{Rapporto di distorsione armonica di secondo modo $\text {HD}_2 = p_2 / p_1$ (espresso in percentuale) in funzione dell'ampiezza di eccitazione $V_{\text {ac}}$. I cerchi verdi rappresentano i dati sperimentali; la retta continua verde mostra la legge teorica lineare $\text {HD}_2 = (k_2/k_1)\,V_{\text {ac}}$ con pendenza $k_{\text {hd2}} = \SI {0.01911}{\%/\milli \volt _{pp}}$}{figure.24}{}}
